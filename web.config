<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <httpRuntime maxQueryStringLength="32768" maxUrlLength="32768" />
  </system.web>
  <system.webServer>
    <!-- SignalR puts the JWT on the query string. IIS default maxQueryString is 2048
         and blocks the hub with 404.15 — chat then works locally (Kestrel) but not live. -->
    <security>
      <requestFiltering>
        <requestLimits maxQueryString="32768" maxUrl="32768" />
      </requestFiltering>
    </security>
    <webSocket enabled="true" />
  </system.webServer>
</configuration>
